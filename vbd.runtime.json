{
  "runtime_checks": [
    {
      "id": "unit-tests",
      "argv": [".venv/bin/python", "-m", "pytest", "tests/", "-q"],
      "timeout_s": 180,
      "paths": ["src/**", "tests/**", "scripts/**", "retracforge/**", "requirements.txt", "vbd.runtime.json"]
    },
    {
      "id": "fixture-path",
      "argv": [".venv/bin/python", "scripts/run_fixture.py", "logs/stage0_fixture"],
      "timeout_s": 120,
      "paths": ["src/**", "scripts/**", "tests/**"]
    },
    {
      "id": "retracforge-sanity",
      "argv": [".venv/bin/python", "retracforge/scripts/sanity_retracforge.py"],
      "timeout_s": 60,
      "paths": ["retracforge/**", "tests/test_retracforge_laws.py"]
    }
  ]
}
